    "@ai-doodle/video-schema": "workspace:*",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.399"
  },
  "devDependencies": {
    "@remotion/cli": "4.0.399",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5"
  }
}
